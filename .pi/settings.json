{
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:@smoose/pi-footer@0.1.5"
  ],
  "footer": {
    "preset": "compact",
    "separator": "pipe",
    "segments": [
      "path",
      "git",
      "model",
      "thinking",
      "context_pct",
      "custom:agents",
      "custom:wumpa"
    ],
    "customItems": [
      {
        "id": "agents",
        "statusKey": "subagent-count",
        "color": "accent"
      },
      {
        "id": "wumpa",
        "statusKey": "wumpa-session",
        "color": "#00afaf"
      }
    ]
  }
}
